ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# Google OAuth
# https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email allowlist — comma-separated list of emails allowed to sign in.
# Case-insensitive; whitespace around entries is tolerated.
# Enforced at account creation AND on every requireUser() call.
# Example: EMAIL_ALLOWLIST="alice@example.com, bob@example.com"
EMAIL_ALLOWLIST=""

# Cloudflare tunnel (for `npm run dev:tunnel`)
# Connector token from: Cloudflare Zero Trust > Networks > Tunnels > <your tunnel>
# cloudflared reads this env var natively — do not rename.
TUNNEL_TOKEN=""
