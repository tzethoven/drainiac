{
  "name": "memento",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:tunnel": "concurrently --kill-others --names vite,tunnel --prefix-colors auto \"vite dev\" \"dotenv -- cloudflared tunnel --no-autoupdate run\"",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@lucide/svelte": "^1.0.1",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tabler/icons-svelte": "^3.40.0",
    "@vitest/ui": "^4.1.5",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "lightningcss": "^1.32.0",
    "tailwindcss": "^4.2.2"
  }
}
